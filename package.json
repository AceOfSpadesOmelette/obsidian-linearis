{
	"name": "linearis",
	"version": "1.1.0",
	"description": "Linearis: VS Code-style source-line gutters for Obsidian notes in editor and reading mode.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest",
		"test:ci": "jest --ci --coverage=false"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"linearis"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.17",
		"builtin-modules": "3.3.0",
		"esbuild": "0.25.5",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.3.4",
		"tslib": "2.8.1",
		"typescript": "^5.8.3"
	}
}
